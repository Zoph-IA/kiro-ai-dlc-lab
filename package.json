{
    "name": "flappy-kiro",
    "version": "1.0.0",
    "description": "Flappy Kiro - An arcade-style browser game",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src/",
        "format": "prettier --write src/ tests/",
        "format:check": "prettier --check src/ tests/",
        "audit": "npm audit"
    },
    "devDependencies": {
        "typescript": "5.7.3",
        "vite": "6.3.5",
        "vitest": "3.1.3",
        "fast-check": "3.23.2",
        "@vitest/coverage-v8": "3.1.3",
        "eslint": "9.18.0",
        "@typescript-eslint/eslint-plugin": "8.21.0",
        "@typescript-eslint/parser": "8.21.0",
        "prettier": "3.4.2",
        "eslint-config-prettier": "10.0.1"
    }
}